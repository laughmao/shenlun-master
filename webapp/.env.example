# 复制为 .env 并填写。.env 已被 .gitignore 排除，不会入库。
SHENLUN_DEFAULT_BASE_URL=https://open.bigmodel.cn/api/anthropic
SHENLUN_DEFAULT_API_KEY=sk-xxxx
SHENLUN_DEFAULT_MODEL=glm-5.3-flash  # 按中转方要求填写模型名

# 注册邀请码：设置后注册必须携带；留空则开放注册
SHENLUN_INVITE_CODE=
# 历史保留天数（0=永久）与库体积兜底（MB），超出自动轮转清理
SHENLUN_HISTORY_DAYS=180
SHENLUN_HISTORY_MAX_MB=512
